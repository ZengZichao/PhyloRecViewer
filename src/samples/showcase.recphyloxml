              </eventsRec>
              <clade>
                <name>M.jannaschii_gene1</name>
                <eventsRec><leaf speciesLocation="M.jannaschii" geneName="M.jannaschii_gene1"/></eventsRec>
              </clade>
              <clade>
                <name>S.solfataricus_gene1</name>
                <eventsRec><leaf speciesLocation="S.solfataricus" geneName="S.solfataricus_gene1"/></eventsRec>
              </clade>
            </clade>
          </clade>
          <clade>
            <name>g_dup2</name>
            <eventsRec><speciation speciesLocation="Bacteria"/></eventsRec>
            <clade>
              <name>E.coli_gene2</name>
              <eventsRec><leaf speciesLocation="E.coli" geneName="E.coli_gene2"/></eventsRec>
            </clade>
            <clade>
              <name>loss_bsub</name>
