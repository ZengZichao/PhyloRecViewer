<recPhylo>
  <spTree>
    <phylogeny rooted="true">
      <clade>
        <name>LUCA</name>
        <clade>
          <name>Bacteria</name>
          <clade><name>E.coli</name></clade>
          <clade><name>B.subtilis</name></clade>
        </clade>
        <clade>
          <name>Archaea</name>
          <clade><name>M.jannaschii</name></clade>
          <clade><name>S.solfataricus</name></clade>
        </clade>
      </clade>
    </phylogeny>
  </spTree>
  <recGeneTree>
    <phylogeny rooted="true">
      <clade>
        <name>g_root</name>
