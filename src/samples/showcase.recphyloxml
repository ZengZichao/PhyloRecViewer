              </clade>
              <clade>
                <name>B.subtilis_gene1</name>
                <eventsRec><leaf speciesLocation="B.subtilis" geneName="B.subtilis_gene1"/></eventsRec>
              </clade>
            </clade>
            <clade>
              <name>g_trans</name>
              <eventsRec>
                <transferBack destinationSpecies="Archaea"/>
