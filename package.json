{
  "name": "phylorecviewer",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "description": "Beautiful, offline, interactive recPhyloXML reconciliation viewer",
  "author": "Zichao Zeng <zengzichao@sjtu.edu.cn>",
  "keywords": ["phylogenetics", "gene tree reconciliation", "recPhyloXML",
    "NHX", "visualization", "horizontal gene transfer", "tube-map"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengZichao/PhyloRecViewer.git"
  },
  "homepage": "https://github.com/ZengZichao/PhyloRecViewer",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:tracked": "node scripts/check-tracked-files.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "measure": "tsx --tsconfig tsconfig.scripts.json scripts/measure.ts",
    "measure:aggregate": "python3 scripts/aggregate-measurements.py",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "fast-xml-parser": "^5.11.1",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svg2pdf.js": "^2.8.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.5",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
