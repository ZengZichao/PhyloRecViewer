{
  "name": "phylorecviewer",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "description": "Beautiful, offline, interactive recPhyloXML reconciliation viewer",
  "author": "Zichao Zeng <zengzichao@sjtu.edu.cn>",
  "keywords": [
    "phylogenetics",
    "gene tree reconciliation",
    "recPhyloXML",
    "NHX",
    "visualization",
    "horizontal gene transfer",
    "tube-map"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZengZichao/PhyloRecViewer.git"
  },
  "homepage": "https://github.com/ZengZichao/PhyloRecViewer",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:tracked": "node scripts/check-tracked-files.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "measure": "tsx --tsconfig tsconfig.scripts.json scripts/measure.ts",
    "cli": "tsx --tsconfig tsconfig.scripts.json scripts/cli.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "fast-xml-parser": "^5.12.0",
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg2pdf.js": "^2.8.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
