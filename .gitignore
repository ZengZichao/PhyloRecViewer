# test and benchmark output
# coverage-summary.json is the machine-readable coverage report the
# documentation cites, so it is tracked; the html/lcov renderings beside it are
# regenerated by `npm run coverage` on every run and stay ignored.
coverage/*
!coverage/coverage-summary.json
_build/

